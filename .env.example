# Database Configuration
MYSQL_DATABASE=amarhealth_db
MYSQL_USER=amarhealth_user
MYSQL_PASSWORD=amarhealth_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Django Configuration
SECRET_KEY=your-django-secret-key-here
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=mysql://amarhealth_user:amarhealth_password@db:3306/amarhealth_db

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_CHATBOT_API_URL=http://localhost:5000

# Chatbot Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-chatbot-secret-key-here
PORT=5000

# Email Configuration (if needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# OpenAI Configuration (if needed for OCR service)
OPENAI_API_KEY=your-openai-api-key-here

# Redis Configuration (if enabled)
REDIS_URL=redis://redis:6379/0
